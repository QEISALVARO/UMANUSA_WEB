# Kunci HMAC untuk menandatangani cookie sesi stateless (wajib di produksi).
# Buat dengan: openssl rand -base64 32   (atau: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))")
# Minimal 32 karakter. Jangan pernah commit nilai aslinya — salin ini ke .env.local (lokal)
# atau Environment Variables Vercel (Project Settings → Environment Variables).
SESSION_SECRET=
